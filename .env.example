# OpenAI powers generated twin answers. Without it, Robosa uses deterministic
# local profile answers.
OPENAI_API_KEY=
ROBOSA_OPENAI_MODEL=gpt-5-nano

# Local profile database and generated avatar archives.
ROBOSA_DATA_DIR=.robosa-data

# Optional MetaPerson avatar generation.
ROBOSA_METAPERSON_CLIENT_ID=
ROBOSA_METAPERSON_CLIENT_SECRET=
# ROBOSA_METAPERSON_DOWNLOAD_HOSTS=example.com,cdn.example.com

# Optional self-hosted LAM GPU worker.
ROBOSA_LAM_WORKER_URL=
ROBOSA_LAM_WORKER_TOKEN=
# ROBOSA_LAM_WORKER_TOKEN_FILE=.robosa-data/lam-worker-token

# HOST=127.0.0.1
# PORT=4173
