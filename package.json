{
  "name": "robosa",
  "private": true,
  "version": "0.1.0",
  "description": "Owner-controlled digital twins with voice, LAM portraits, and interactive 3D avatars.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --open /studio --host 127.0.0.1 --port 4173 --strictPort",
    "dev:robosa": "vite --open /studio --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test src/robosa/*.test.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "qa:avatar": "node scripts/qa-robosa-avatar-generation.mjs",
    "qa:lam-generation": "node scripts/qa-robosa-lam-generation.mjs",
    "qa:lam": "node scripts/qa-robosa-lam.mjs",
    "qa:portrait": "node scripts/qa-robosa-portrait.mjs"
  },
  "dependencies": {
    "@met4citizen/headaudio": "^0.1.0",
    "@pixiv/three-vrm": "^3.5.5",
    "gaussian-splat-renderer-for-lam": "^0.0.9-alpha.1",
    "jszip": "^3.10.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.0"
  }
}
